{
  "name": "webframez-react-dev",
  "private": true,
  "scripts": {
    "build:framework": "pnpm --dir .. run build",
    "build:core": "pnpm --dir ../../webframez-core run build",
    "clean": "rm -rf dist",
    "build:client": "node ../bin/webframez-react.mjs build:client",
    "build:server": "node ../bin/webframez-react.mjs build:server",
    "build": "pnpm run build:core && pnpm run build:framework && pnpm run clean && pnpm run build:server && pnpm run build:client",
    "watch:core": "pnpm --dir ../../webframez-core run build --watch --preserveWatchOutput",
    "watch:framework": "pnpm --dir .. run build:watch",
    "watch:server": "node ../bin/webframez-react.mjs watch:server",
    "watch:client": "node ../bin/webframez-react.mjs watch:client",
    "serve:watch": "node --watch --conditions react-server start-server.cjs",
    "dev:watch": "sh -c 'pnpm run watch:core & pnpm run watch:framework & pnpm run watch:server & pnpm run watch:client & pnpm run serve:watch & wait'",
    "dev": "pnpm run build && pnpm run dev:watch"
  },
  "dependencies": {
    "@webtypen/webframez-core": "^0.3.65",
    "@webtypen/webframez-react": "^0.0.49",
    "react": "0.0.0-experimental-95ffd6cd-20260205",
    "react-dom": "0.0.0-experimental-95ffd6cd-20260205",
    "react-server-dom-webpack": "0.0.0-experimental-95ffd6cd-20260205"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
